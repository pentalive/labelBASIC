
Begin:
    xtend cls
    let pl = 1
   
    do
        let $thetime = $time()
        xtend cls
        xtend at pl pl*2 
        print "clock ",$thetime

; loop for the next second
        do
            
            if $time() <> $thetime then break
        next
        let pl = pl + 1
        if pl > 23 then let pl = 1

    next

    end
